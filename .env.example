# ============================================================================
# PROJETO ORION — Configuração de Ambiente
# ============================================================================
# Copie para .env e ajuste os valores.
# NUNCA comite o arquivo .env com dados reais.
# ============================================================================

# --- Ambiente ---
# Opções: dev | homolog | prod | teste
MESTRE_IA_AMBIENTE=dev

# --- Debug ---
MESTRE_IA_DEBUG=true

# --- Logging ---
MESTRE_IA_LOGGING_NIVEL=DEBUG
MESTRE_IA_LOGGING_FORMATO=texto
MESTRE_IA_LOGGING_DESTINO=stdout

# --- DeepSeek ---
# Obtenha em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-sua-api-key-aqui
DEEPSEEK_MODELO_PADRAO=deepseek-chat
